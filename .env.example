# Copy to .env.local and fill in. .env.local is gitignored; .env holds non-secret defaults.

# Which provider backs the agents: openai or gemini.
# Gemini is reached through its OpenAI-compatible endpoint, so nothing else changes.
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# Point at a LiteLLM proxy, an Azure OpenAI deployment, or any OpenAI-compatible
# endpoint. Set this and it wins over the provider's own base URL.
# BASE_URL_OVERRIDE=https://your-proxy/v1

# Model routing. Vision and reasoning get the strong model, bulk work the cheap one.
# Leave any of these blank to take the selected provider's default:
#   openai -> gpt-4o / gpt-4o / gpt-4o-mini
#   gemini -> gemini-2.5-flash / gemini-2.5-flash / gemini-2.5-flash-lite
# Check the provider's current model list - these move fast.
VISION_MODEL=
REASONING_MODEL=
FAST_MODEL=

# OpenAI only. Gemini's compatible surface serves no /audio/* endpoints, so on Gemini
# the dashboard uses the browser's own speech engine for both dictation and playback.
TRANSCRIBE_MODEL=whisper-1
SPEECH_MODEL=gpt-4o-mini-tts
SPEECH_VOICE=alloy

# Camera and the brightness door trigger.
# A camera inside a closed fridge reads near 0. Open with the light on reads 80-180.
# Point a webcam at your desk and watch the reading in the dashboard to tune these.
CAMERA_INDEX=0
DOOR_OPEN_BRIGHTNESS=60
DOOR_CLOSE_BRIGHTNESS=40
SETTLE_FRAMES=8

# The whole door cycle is recorded and sent to the model as one clip.
# CLIP_FPS is only a fallback for cameras that will not report their own frame rate.
# CLIP_SAMPLE_FPS is how densely the model samples the clip: Google's default of 1 fps
# misses a fast hand-through-the-door crossing, 2 catches them. Raise it if yours are missed.
# Video input needs LLM_PROVIDER=gemini; on OpenAI the vision agent compares two stills
# pulled out of the same clip instead.
CLIP_FPS=15
CLIP_SAMPLE_FPS=2
CLIP_MAX_SECONDS=60

# The confidence gate. Above the first, the fridge writes; between them, it asks;
# below the second, it stays quiet.
AUTO_COMMIT_CONFIDENCE=0.8
REJECT_CONFIDENCE=0.25

EXPIRING_SOON_DAYS=3

# Force every agent onto its offline path, even with a key present. Useful for rehearsal.
OFFLINE_MODE=false
